      "source": [
        "# ===================== AI WEBSITE BUILDER: ONE COLAB CELL =====================\n",
        "# Paste this WHOLE thing into ONE Colab cell and press Play.\n",
        "# Before running: add secrets (key icon on the left) GEMINI_API_KEY and SERPAPI_KEY, Notebook access ON.\n",
        "\n",
        "import os, re, time, subprocess, textwrap, getpass\n",
        "subprocess.run(\"pip -q install streamlit google-genai faiss-cpu pandas numpy plotly openpyxl requests python-dotenv\", shell=True)\n",
        "\n",
        "# ---------- 1. load secret keys (never written into any file) ----------\n",
        "def get_key(name):\n",
        "    try:\n",
        "        from google.colab import userdata\n",
        "        v = userdata.get(name)\n",
        "        if v: return v\n",
        "    except Exception:\n",
        "        pass\n",
        "    return os.getenv(name) or getpass.getpass(f\"Enter {name}: \")\n",
        "os.environ[\"GEMINI_API_KEY\"] = get_key(\"GEMINI_API_KEY\")\n",
        "os.environ[\"SERPAPI_KEY\"] = get_key(\"SERPAPI_KEY\")\n",
        "\n",
        "# ---------- 2. create the GitHub-ready project folder ----------\n",
        "os.makedirs(\"ai-website-builder\", exist_ok=True); os.chdir(\"ai-website-builder\")\n",
        "\n",
        "APP = r'''\n",
        "import os, re, json, time, hashlib, requests, numpy as np, pandas as pd, faiss\n",
        "import streamlit as st, plotly.express as px\n",
        "import streamlit.components.v1 as components\n",
        "from html.parser import HTMLParser\n",
        "from google import genai\n",
        "from dotenv import load_dotenv\n",
        "\n",
        "load_dotenv()\n",
        "GKEY, SKEY = os.getenv(\"GEMINI_API_KEY\", \"\"), os.getenv(\"SERPAPI_KEY\", \"\")\n",
        "st.set_page_config(page_title=\"AI Website Builder\", page_icon=\"🤖\", layout=\"wide\")\n",
        "\n",
        "# ---------------- Gemini (auto-fallback between models, so it does not break) ----------------\n",
        "if not GKEY:\n",
        "    st.error(\"GEMINI_API_KEY is missing. Add it to your .env file or Colab Secrets.\"); st.stop()\n",
        "client = genai.Client(api_key=GKEY, http_options={\"timeout\": 45000})  # 45s max per request, so it can never hang\n",
        "MODELS = [m for m in [os.getenv(\"GEMINI_MODEL\"), \"gemini-flash-lite-latest\", \"gemini-3.5-flash-lite\", \"gemini-3.1-flash-lite\", \"gemini-2.5-flash-lite\"] if m]\n",
        "\n",
        "def ask(prompt, as_json=False):\n",
        "    cfg = {\"response_mime_type\": \"application/json\"} if as_json else None\n",
        "    last = None\n",
        "    good = st.session_state.get(\"good_model\")  # remember the model that worked, try it first\n",
        "    order = ([good] if good in MODELS else []) + [m for m in MODELS if m != good]\n",
        "    for _ in range(2):\n",
        "        for m in order:\n",
        "            try:\n",
        "                st.toast(f\"Asking {m}...\")\n",
        "                r = client.models.generate_content(model=m, contents=prompt, config=cfg)\n",
        "                if r.text:\n",
        "                    st.session_state[\"good_model\"] = m; return r.text\n",
        "            except Exception as e:\n",
        "                last = e\n",
        "        if \"429\" in str(last) or \"RESOURCE_EXHAUSTED\" in str(last): time.sleep(8)  # free-limit pause, then try once more\n",
        "        else: break\n",
        "    raise RuntimeError(f\"Gemini did not answer: {last}\")\n",
        "\n",
        "def clean_html(t):\n",
        "    t = re.sub(r\"^```[a-zA-Z]*\\s*|\\s*```$\", \"\", t.strip())\n",
        "    i = max(t.lower().find(\"<!doctype\"), 0)\n",
        "    return t[i:]\n",
        "\n",
        "# ---------------- Google search (SerpAPI) ----------------\n",
        "def serp(q, n=6):\n",
        "    if not SKEY: return []\n",
        "    try:\n",
        "        r = requests.get(\"https://serpapi.com/search.json\",\n",
        "                         params={\"q\": q, \"api_key\": SKEY, \"num\": n}, timeout=30)\n",
        "        r.raise_for_status()\n",
        "        return [{\"title\": x.get(\"title\", \"\"), \"link\": x.get(\"link\", \"\"), \"snippet\": x.get(\"snippet\", \"\")}\n",
        "                for x in r.json().get(\"organic_results\", [])[:n]]\n",
        "    except Exception as e:\n",
        "        st.warning(f\"Google search problem: {e}\"); return []\n",
        "\n",
        "# ---------------- FAISS memory (falls back to a local embedder if Gemini embeddings fail) ----------------\n",
        "def unit(v):\n",
        "    n = np.linalg.norm(v, axis=1, keepdims=True); n[n == 0] = 1\n",
        "    return (v / n).astype(\"float32\")\n",
        "\n",
        "def local_embed(texts, dim=512):\n",
        "    out = np.zeros((len(texts), dim), \"float32\")\n",
        "    for i, t in enumerate(texts):\n",
        "        for w in re.findall(r\"[a-z0-9]+\", t.lower()):\n",
        "            out[i, int(hashlib.md5(w.encode()).hexdigest(), 16) % dim] += 1\n",
        "    return unit(out)\n",
        "\n",
        "class Memory:\n",
        "    def __init__(self):\n",
        "        self.index, self.texts, self.mode = None, [], \"gemini\"\n",
        "        try: self._g([\"test\"])\n",
        "        except Exception: self.mode = \"local\"\n",
        "    def _g(self, t):\n",
        "        r = client.models.embed_content(model=\"gemini-embedding-001\", contents=t)\n",
        "        return unit(np.array([e.values for e in r.embeddings], \"float32\"))\n",
        "    def emb(self, t): return self._g(t) if self.mode == \"gemini\" else local_embed(t)\n",
        "    def add(self, texts):\n",
        "        texts = [t for t in texts if t.strip()]\n",
        "        if not texts: return\n",
        "        v = self.emb(texts)\n",
        "        if self.index is None: self.index = faiss.IndexFlatIP(v.shape[1])\n",
        "        self.index.add(v); self.texts += texts\n",
        "    def search(self, q, k=5):\n",
        "        if self.index is None: return []\n",
        "        _, ids = self.index.search(self.emb([q]), min(k, len(self.texts)))\n",
        "        return [self.texts[i] for i in ids[0] if i >= 0]\n",
        "\n",
        "S = st.session_state\n",
        "for k, v in {\"mem\": None, \"status\": {}, \"stage\": \"start\", \"templates\": [], \"html\": \"\", \"inspo\": [], \"command\": \"\"}.items():\n",
        "    S.setdefault(k, v)\n",
        "if S.mem is None: S.mem = Memory()\n",
        "\n",
        "# ---------------- live agent board ----------------\n",
        "AGENTS = {\"🔎 Researcher\": \"Searches Google, saves facts in FAISS\",\n",
        "          \"🎨 Designer\": \"Proposes 3 model websites\",\n",
        "          \"🛠️ Builder\": \"Writes the full website\",\n",
        "          \"🧪 Tester\": \"Checks every button has working code\",\n",
        "          \"📊 Analyst\": \"Explains your uploaded data\"}\n",
        "board = st.sidebar.empty()\n",
        "def show_board():\n",
        "    with board.container():\n",
        "        st.markdown(\"### 🤖 Agent Team\")\n",
        "        for a, d in AGENTS.items():\n",
        "            st.markdown(f\"**{a}** — {S.status.get(a, '💤 waiting')}<br><small>{d}</small>\", unsafe_allow_html=True)\n",
        "show_board()\n",
        "st.sidebar.markdown(\"### ⚙️ Settings\")\n",
        "_unl = st.sidebar.checkbox(\"Keep fixing until perfect (no round limit)\", value=True)\n",
        "S[\"max_rounds\"] = 0 if _unl else st.sidebar.slider(\"Max fix rounds\", 1, 30, 5)\n",
        "\n",
        "def run(agent, fn, *args):\n",
        "    S.status[agent] = \"🟢 working...\"; show_board()\n",
        "    try:\n",
        "        out = fn(*args); S.status[agent] = \"✅ done\"; return out\n",
        "    except Exception:\n",
        "        S.status[agent] = \"❌ failed\"; raise\n",
        "    finally:\n",
        "        show_board()\n",
        "\n",
        "# ---------------- agent logic ----------------\n",
        "def researcher(niche):\n",
        "    hits = serp(f\"{niche} AI website latest trends\", 6)\n",
        "    S.inspo = serp(f\"best {niche} website design examples\", 5)\n",
        "    S.mem.add([f\"{h['title']}: {h['snippet']}\" for h in hits])\n",
        "    return hits\n",
        "\n",
        "FALLBACK = [\n",
        "    {\"name\": \"Clean Modern\", \"style\": \"White, spacious, big headline\", \"sections\": [\"Hero\", \"Features\", \"Pricing\", \"Contact\"], \"colors\": [\"#ffffff\", \"#2563eb\", \"#111827\"], \"why\": \"Trusted and easy to read.\"},\n",
        "    {\"name\": \"Dark Tech\", \"style\": \"Dark background, neon accents\", \"sections\": [\"Hero\", \"Demo\", \"Features\", \"Contact\"], \"colors\": [\"#0b1020\", \"#22d3ee\", \"#a78bfa\"], \"why\": \"Feels futuristic, great for AI.\"},\n",
        "    {\"name\": \"Friendly Bold\", \"style\": \"Warm colors, rounded cards\", \"sections\": [\"Hero\", \"How it works\", \"FAQ\", \"Contact\"], \"colors\": [\"#fff7ed\", \"#f97316\", \"#7c2d12\"], \"why\": \"Welcoming for beginners.\"}]\n",
        "\n",
        "def designer(cmd):\n",
        "    facts = \"\\n\".join(S.mem.search(cmd))\n",
        "    try:\n",
        "        t = json.loads(clean_json(ask(f\"\"\"The user wants a website: \"{cmd}\".\n",
        "Facts from Google (use them for ideas): {facts}\n",
        "Return a JSON list of exactly 3 different model website concepts, each with keys:\n",
        "name, style, sections (list of strings), colors (list of 3 hex codes), why.\"\"\", True)))\n",
        "        ok = isinstance(t, list) and len(t) >= 3 and all({\"name\", \"style\", \"sections\", \"colors\", \"why\"} <= set(x) for x in t[:3])\n",
        "        return t[:3] if ok else FALLBACK\n",
        "    except Exception:\n",
        "        return FALLBACK\n",
        "\n",
        "def clean_json(t): return re.sub(r\"^```(json)?\\s*|\\s*```$\", \"\", t.strip())\n",
        "\n",
        "def builder(cmd, tpl):\n",
        "    facts = \"\\n\".join(S.mem.search(cmd, 6)) or \"(no search facts available)\"\n",
        "    return clean_html(ask(f\"\"\"Create ONE complete, single-file website (HTML + CSS + JavaScript).\n",
        "Request: {cmd}\n",
        "Chosen model website: {json.dumps(tpl)}\n",
        "Real facts found on Google (only source of factual claims): {facts}\n",
        "\n",
        "STRICT RULES:\n",
        "1. Never invent statistics, prices, customer names, testimonials or awards. If unsure, write general wording.\n",
        "2. Responsive, modern, accessible, with a working mobile menu and dark-mode toggle.\n",
        "3. EVERY button, tab, link and form must have real working JavaScript (smooth scroll, tabs, FAQ toggles, contact form validation with a success message).\n",
        "4. Include a section \"Data Visualizer\": a file input for CSV, X column / Y column / chart type dropdowns, a Draw button.\n",
        "   Load PapaParse and Chart.js from https://cdnjs.cloudflare.com only. Use ONLY the real uploaded values.\n",
        "5. No remote images or fonts (use CSS gradients, emoji, inline SVG).\n",
        "Return ONLY the HTML document, starting with <!DOCTYPE html>.\"\"\"))\n",
        "\n",
        "class Check(HTMLParser):\n",
        "    def __init__(s):\n",
        "        super().__init__(); s.ids, s.btn, s.handlers, s.scripts = [], [], [], []\n",
        "        s.cur, s.ins, s.form, s.skip = \"\", False, 0, False\n",
        "    def handle_starttag(s, t, a):\n",
        "        a = dict(a)\n",
        "        if a.get(\"id\"): s.ids.append(a[\"id\"])\n",
        "        for k, v in a.items():\n",
        "            if k.startswith(\"on\") and v: s.handlers.append(v)\n",
        "        if t == \"form\": s.form += 1\n",
        "        if t == \"script\": s.ins, s.cur, s.skip = True, \"\", bool(a.get(\"src\"))\n",
        "        if t == \"button\" and not a.get(\"onclick\") and not s.form:\n",
        "            s.btn.append(a.get(\"id\") or (a.get(\"class\") or \"button\").split()[0])\n",
        "    def handle_endtag(s, t):\n",
        "        if t == \"form\": s.form -= 1\n",
        "        if t == \"script\":\n",
        "            s.ins = False\n",
        "            if not s.skip: s.scripts.append(s.cur)\n",
        "    def handle_data(s, d):\n",
        "        if s.ins: s.cur += d\n",
        "\n",
        "BUILTIN = {\"alert\", \"confirm\", \"prompt\", \"if\", \"return\", \"function\", \"setTimeout\", \"event\", \"this\", \"scrollTo\", \"open\", \"close\", \"toggle\", \"add\", \"remove\", \"reset\", \"submit\", \"focus\", \"click\", \"preventDefault\"}\n",
        "\n",
        "def js_errors(scripts):\n",
        "    import shutil, subprocess, tempfile\n",
        "    node = shutil.which(\"node\")\n",
        "    if not node: return []\n",
        "    errs = []\n",
        "    for sc in scripts:\n",
        "        if not sc.strip(): continue\n",
        "        with tempfile.NamedTemporaryFile(\"w\", suffix=\".js\", delete=False) as f: f.write(sc)\n",
        "        p = subprocess.run([node, \"--check\", f.name], capture_output=True, text=True)\n",
        "        if p.returncode: errs.append(\"JavaScript syntax error: \" + (p.stderr.strip().splitlines() or [\"unknown\"])[-1][:200])\n",
        "    return errs\n",
        "\n",
        "def issues(html):\n",
        "    c = Check(); c.feed(html)\n",
        "    code, low, p = \"\\n\".join(c.scripts), html.lower(), []\n",
        "    if \"</html>\" not in low: p.append(\"document is cut off, missing </html>\")\n",
        "    p += [f\"duplicate id '{i}'\" for i in sorted({x for x in c.ids if c.ids.count(x) > 1})]\n",
        "    p += [f\"button '{b}' has no JavaScript behind it\" for b in c.btn if b not in code]\n",
        "    for h in c.handlers:\n",
        "        for n in re.findall(r\"(?<![\\w.])([A-Za-z_]\\w*)\\s*\\(\", h):\n",
        "            if n not in BUILTIN and not re.search(rf\"function\\s+{n}\\b|\\b{n}\\s*=|(const|let|var)\\s+{n}\\b\", code):\n",
        "                p.append(f\"onclick calls '{n}' but it is never defined\")\n",
        "    for i in re.findall(r\"getElementById\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\", code):\n",
        "        if i not in c.ids: p.append(f\"JavaScript looks for id '{i}' but no such element exists\")\n",
        "    if \"papaparse\" not in low or \"chart\" not in low or 'type=\"file\"' not in low.replace(\"'\", '\"').replace(\"type = \", \"type=\"):\n",
        "        p.append(\"Data Visualizer section is missing (needs file input, PapaParse and Chart.js)\")\n",
        "    p += js_errors(c.scripts)\n",
        "    return sorted(set(p))\n",
        "\n",
        "def tester(html):\n",
        "    max_rounds, rnd, stalled, last = S.get(\"max_rounds\", 0), 0, 0, None\n",
        "    while True:\n",
        "        probs = issues(html)\n",
        "        if not probs:\n",
        "            S.status[\"🧪 Tester\"] = f\"🟢 all checks passed after {rnd} fix round(s)\"; show_board(); return html\n",
        "        if max_rounds and rnd >= max_rounds:\n",
        "            st.warning(\"Stopped at your round limit. Still open: \" + \"; \".join(probs)); return html\n",
        "        stalled = stalled + 1 if probs == last else 0\n",
        "        if stalled >= 3:\n",
        "            st.warning(\"Gemini could not fix these after repeated tries: \" + \"; \".join(probs) + \". Use 'Apply change' to guide it.\"); return html\n",
        "        last, rnd = probs, rnd + 1\n",
        "        S.status[\"🧪 Tester\"] = f\"🟢 round {rnd}: fixing {len(probs)} problem(s)\"; show_board()\n",
        "        try:\n",
        "            new = clean_html(ask(\"Fix ALL of these problems in the website below, change nothing else, keep every feature working.\\nProblems:\\n- \" + \"\\n- \".join(probs) + \"\\nReturn ONLY the full HTML.\\n\\n\" + html))\n",
        "            if \"</html>\" in new.lower(): html = new\n",
        "        except Exception as e:\n",
        "            st.warning(f\"Gemini paused ({e}). Returning the best version so far.\"); return html\n",
        "\n",
        "def analyst(stats):\n",
        "    return ask(\"Explain this dataset to a beginner in short bullets. Use ONLY the numbers below, never invent any.\\n\" + stats)\n",
        "\n",
        "# ---------------- screen ----------------\n",
        "st.title(\"🤖 AI Website Builder Agent\")\n",
        "tab1, tab2, tab3 = st.tabs([\"🌐 Build Website\", \"📊 Data Visualization\", \"🔍 Live Google Search\"])\n",
        "\n",
        "with tab1:\n",
        "    cmd = st.text_input(\"Tell me what website you want:\", placeholder=\"e.g. A website for my AI chatbot startup for dentists\")\n",
        "    if st.button(\"🚀 Start\", type=\"primary\") and cmd:\n",
        "        S.command, S.html, S.mem = cmd, \"\", Memory()\n",
        "        try:\n",
        "            run(\"🔎 Researcher\", researcher, cmd)\n",
        "            S.templates = run(\"🎨 Designer\", designer, cmd); S.stage = \"pick\"\n",
        "        except Exception as e:\n",
        "            st.error(f\"Could not start: {e}\")\n",
        "    if S.stage == \"pick\" and S.templates:\n",
        "        st.subheader(\"Pick a model website\")\n",
        "        for i, (c, t) in enumerate(zip(st.columns(3), S.templates)):\n",
        "            with c:\n",
        "                st.markdown(f\"#### {t['name']}\"); st.write(t[\"style\"])\n",
        "                st.caption(\"Sections: \" + \", \".join(map(str, t[\"sections\"])))\n",
        "                st.markdown(\" \".join(f\"<span style='background:{x};padding:4px 16px;border-radius:6px;border:1px solid #8884'>&nbsp;</span>\" for x in t[\"colors\"]), unsafe_allow_html=True)\n",
        "                st.write(t[\"why\"])\n",
        "                if st.button(\"Build this one ✨\", key=f\"b{i}\"):\n",
        "                    try:\n",
        "                        h = run(\"🛠️ Builder\", builder, S.command, t)\n",
        "                        S.html = run(\"🧪 Tester\", tester, h); S.stage = \"done\"\n",
        "                    except Exception as e:\n",
        "                        st.error(f\"Build failed: {e}\")\n",
        "        if S.inspo:\n",
        "            with st.expander(\"Real example websites from Google\"):\n",
        "                for r in S.inspo: st.markdown(f\"- [{r['title']}]({r['link']})\")\n",
        "    if S.html:\n",
        "        st.success(\"Your website is running below.\")\n",
        "        components.html(S.html, height=800, scrolling=True)\n",
        "        st.download_button(\"⬇️ Download website (index.html)\", S.html, \"index.html\", \"text/html\")\n",
        "        fix = st.text_input(\"Want a change? Describe it:\")\n",
        "        if st.button(\"Apply change\") and fix:\n",
        "            try:\n",
        "                new = run(\"🛠️ Builder\", lambda: clean_html(ask(f\"Apply this change: {fix}\\nKeep every button working. Return ONLY the full HTML.\\n\\n{S.html}\")))\n",
        "                S.html = run(\"🧪 Tester\", tester, new); st.rerun()\n",
        "            except Exception as e:\n",
        "                st.error(f\"Change failed: {e}\")\n",
        "\n",
        "with tab2:\n",
        "    st.write(\"Upload a CSV or Excel file. Every number is calculated by pandas (exact math), not guessed by AI.\")\n",
        "    f = st.file_uploader(\"Upload data\", type=[\"csv\", \"xlsx\", \"xls\"])\n",
        "    df = None\n",
        "    if f:\n",
        "        try:\n",
        "            df = pd.read_csv(f) if f.name.lower().endswith(\".csv\") else pd.read_excel(f)\n",
        "        except Exception as e:\n",
        "            st.error(f\"Could not read file: {e}\")\n",
        "    if df is not None:\n",
        "        for col in df.select_dtypes(\"object\").columns:  # text -> number ONLY if every value converts cleanly\n",
        "            conv = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "            if df[col].notna().any() and conv.notna().sum() == df[col].notna().sum(): df[col] = conv\n",
        "        st.dataframe(df.head(50))\n",
        "        st.caption(f\"{len(df)} rows × {len(df.columns)} columns · {int(df.isna().sum().sum())} missing values\")\n",
        "        num = df.select_dtypes(\"number\").columns.tolist()\n",
        "        c1, c2, c3, c4 = st.columns(4)\n",
        "        kind = c1.selectbox(\"Chart\", [\"Bar\", \"Line\", \"Scatter\", \"Histogram\", \"Pie\", \"Box\"])\n",
        "        x = c2.selectbox(\"X column\", df.columns)\n",
        "        y = c3.selectbox(\"Y column (numbers)\", [None] + num)\n",
        "        agg = c4.selectbox(\"Combine rows by\", [\"sum\", \"mean\", \"count\", \"median\", \"none\"])\n",
        "        d = df\n",
        "        if y and agg != \"none\" and kind in (\"Bar\", \"Line\", \"Pie\"):\n",
        "            d = df.groupby(x, dropna=False)[y].agg(agg).reset_index()\n",
        "        if y is None and kind in (\"Line\", \"Scatter\", \"Pie\"):\n",
        "            st.info(\"Pick a number column for Y to draw this chart.\")\n",
        "        else:\n",
        "            try:\n",
        "                fig = {\"Bar\": lambda: px.bar(d, x=x, y=y), \"Line\": lambda: px.line(d, x=x, y=y),\n",
        "                       \"Scatter\": lambda: px.scatter(d, x=x, y=y), \"Histogram\": lambda: px.histogram(d, x=x),\n",
        "                       \"Pie\": lambda: px.pie(d, names=x, values=y), \"Box\": lambda: px.box(d, x=x, y=y)}[kind]()\n",
        "                st.plotly_chart(fig)\n",
        "                st.markdown(\"**Exact numbers behind the chart:**\"); st.dataframe(d.head(200))\n",
        "            except Exception as e:\n",
        "                st.error(f\"Cannot draw this combination: {e}\")\n",
        "        if st.button(\"🧠 Explain my data\"):\n",
        "            try: st.markdown(run(\"📊 Analyst\", analyst, df.iloc[:, :30].describe(include=\"all\").round(4).to_string()[:6000]))\n",
